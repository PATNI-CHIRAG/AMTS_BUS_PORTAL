DEBUG=False
SECRET_KEY=generate-a-strong-random-key-for-production
ALLOWED_HOSTS=*

# Cloud Database URL (Render / Railway / Neon / Supabase / AWS)
# Example: postgresql://user:password@host.region.neon.tech/amts_portal_db
DATABASE_URL=

# Or Individual PostgreSQL credentials (Local / Self-hosted)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=amts_portal_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Production Frontend Origin (e.g. https://your-amts-app.vercel.app)
FRONTEND_URL=
CORS_ALLOW_ALL_ORIGINS=False
